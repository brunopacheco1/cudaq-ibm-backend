name: ibm
description: "Run CUDA-Q kernels on IBM Quantum hardware."
cudaq-version: "@CUDA_QUANTUM_VERSION@"
config:
  platform-qpu: remote_rest
  gen-target-backend: true
  preprocessor-defines: ["-D CUDAQ_QUANTUM_DEVICE"]
  link-libs: ["-lcudaq-rest-qpu"]
  # CUDA-Q decomposes every kernel into a small textbook gate set, routes it
  # on the chip's wiring (qubit-mapping; IBMServerHelper writes the device
  # file and fills %QPU_ARCH%, see Layout.h), and prints it as OpenQASM 2.
  # IBMServerHelper then picks IBM qubits for the labels and rewrites the
  # gates into IBM's native {rz, sx, x, cz} (see Qasm2ToIsa.h). The routing
  # part follows iqm.yml, plus placement=auto search=sabre (far fewer swaps
  # than the default identity start: GHZ-20 on ibm_fez needs 28 cz instead
  # of 151). Checked with pip cudaq 0.16.0 (experiments/m3_routing.py).
  # combine-measurements (then expand-measurements and cc-loop-unroll to
  # turn the combined measure back into one per qubit) makes the circuit
  # measure every qubit in allocation order and records which ones the
  # user measured in output_names; processResults keeps those (see
  # ResultBits.h, decision 0010). Without it, a kernel that measures out of
  # order comes back in the wrong bit order, with any router options
  # (experiments/m3_bit_order.py).
  # The second decomposition, after qubit-mapping, turns the swaps the router
  # adds into cx (iqm.yml repeats its gate-set mapping there for the same
  # reason). Without it the helper receives `swap` lines and refuses them
  # (found in the first run of the built plugin; tests/test_target_yml.py).
  # No `dqe` (iqm.yml has it after factor-quantum-alloc): that pass removes
  # a qubit no gate touches, and the result then has one bit too few. Here
  # every allocated qubit keeps its place and is measured
  # (docs/m4-spec.md D5; tests/run_fake_ibm_results.py has idle-qubit cases).
  jit-high-level-pipeline: "expand-measurements"
  jit-mid-level-pipeline: "func.func(erase-implicit-output),decomposition{basis=h,rx,ry,rz,x,z,x(1)},func.func(add-dealloc,combine-quantum-alloc,canonicalize,combine-measurements),expand-measurements,func.func(cc-loop-unroll,canonicalize,factor-quantum-alloc,cse,memtoreg),add-wireset,func.func(assign-wire-indices),qubit-mapping{device=file(%QPU_ARCH%) placement=auto search=sabre},func.func(delay-measurements),decomposition{basis=h,rx,ry,rz,x,z,x(1)},lower-to-cfg,func.func(regtomem),quake-to-cc-prep,func.func(memtoreg{quantum=0})"
  codegen-emission: qasm2
  library-mode: false

target-arguments:
  - key: backend
    required: false
    type: string
    platform-arg: backend
    help-string: "IBM backend name, e.g. ibm_fez (default)."
  - key: url
    required: false
    type: string
    platform-arg: url
    help-string: "IBM Quantum API base URL (default https://quantum.cloud.ibm.com/api)."
  - key: iam_url
    required: false
    type: string
    platform-arg: iam_url
    help-string: "IBM Cloud IAM token URL (default https://iam.cloud.ibm.com/identity/token). Override only for testing."
  - key: mapping_file
    required: false
    type: string
    platform-arg: mapping_file
    help-string: "Device file to route on instead of fetching the chip (testing). Node ids must be IBM qubit ids."
