name: ibm
description: "Run CUDA-Q kernels on IBM Quantum hardware."
cudaq-version: "@CUDA_QUANTUM_VERSION@"
config:
  platform-qpu: remote_rest
  gen-target-backend: true
  preprocessor-defines: ["-D CUDAQ_QUANTUM_DEVICE"]
  link-libs: ["-lcudaq-rest-qpu"]
  # CUDA-Q decomposes every kernel into a small textbook gate set and prints
  # it as OpenQASM 2. IBMServerHelper then rewrites those gates into IBM's
  # native {rz, sx, x, cz} (see Qasm2ToIsa.h). Same pattern as infleqtion.yml.
  jit-high-level-pipeline: "expand-measurements"
  jit-mid-level-pipeline: "decomposition{basis=h,rx,ry,rz,x,z,x(1)},quake-to-cc-prep,func.func(memtoreg{quantum=0})"
  codegen-emission: qasm2
  library-mode: false

target-arguments:
  - key: backend
    required: false
    type: string
    platform-arg: backend
    help-string: "IBM backend name, e.g. ibm_fez (default)."
  - key: url
    required: false
    type: string
    platform-arg: url
    help-string: "IBM Quantum API base URL (default https://quantum.cloud.ibm.com/api)."
  - key: iam_url
    required: false
    type: string
    platform-arg: iam_url
    help-string: "IBM Cloud IAM token URL (default https://iam.cloud.ibm.com/identity/token). Override only for testing."
